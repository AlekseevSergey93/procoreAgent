# Procore Developer Managed Service Account (client_credentials grant)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_COMPANY_ID=

# sandbox | production. Hosts are derived from this unless overridden below.
PROCORE_ENV=sandbox
# PROCORE_API_BASE=https://sandbox.procore.com
# PROCORE_LOGIN_BASE=https://login-sandbox.procore.com
# PROCORE_WEB_BASE=https://sandbox.procore.com

# IANA timezone used to decide what "today" is (defaults to the server timezone)
# PROCORE_TIMEZONE=America/New_York

# How long API responses are cached in memory
PROCORE_CACHE_TTL_SECONDS=600
# Parallel project loads for the portfolio overview
PROCORE_CONCURRENCY=3

# Budget view to read (defaults to the first view on the project)
# PROCORE_BUDGET_VIEW_ID=
# Path to risk thresholds (defaults to config/thresholds.json)
# PROCORE_THRESHOLDS_PATH=
